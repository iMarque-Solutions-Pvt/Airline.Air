<script type="text/javascript">

    //function getSMSDetails() {

    //    $('#SMSContentModal').modal();
    //}

    var protocol = $(location).attr('protocol');
    var host = $(location).attr('host');
    var hostname = $(location).attr('hostname');
    var pathName = $(location).attr('pathname').split('/')[1] + "/";
    var appname;

    if (hostname == 'localhost') {
        appname = "";
    }
    else {
        appname = pathName;
    }


    function getDetails(ID) {
        try {
            var url = protocol + "//" + host + "/" + appname + "Disruption/GetDisruptionById?id=" + ID;
            $("#ModalTitle").html("Update Template");
            //$("#DisruptionDetailsModal").modal("show");
            $.ajax({
                type: "GET",
                url: url,
                success: function (data) {
                    var obj = JSON.parse(data);
                    $("#rowid").text(obj.rowid);
                    $("#flight_number").text(obj.flight_number);
                    $("#intimation_refno").text(obj.intimation_refno);
                    $("#origin").text(obj.origin);
                    $("#destination").text(obj.destination);
                    $("#revised_origin").text(obj.revised_origin);
                    $("#revised_destination").text(obj.revised_destination);
                    $("#actual_departure").text(obj.actual_departure);
                    $("#actual_arrival").text(obj.actual_arrival);
                    $("#revised_departure").text(obj.revised_departure);
                    $("#revised_arrival").text(obj.revised_arrival);
                    $("#disruption_type").text(obj.disruption_type);
                    $("#sms").text(obj.sms);
                    $("#email").text(obj.email);
                    $("#out_calling").text(obj.out_calling);
                    $("#mail_received_time").text(obj.mail_received_time);
                    $("#action_time").text(obj.action_time);
                    $("#remarks").text(obj.remarks);
                    $("#domestic_template").text(obj.domestic_template);
                    $("#international_template").text(obj.international_template);

                    $('#DisruptionDetailsModal').modal();
                }
            })

        } catch (errorMessage) {
            toastr.error(errorMessage)
        }
    }


    function getSMSDetails(ID) {
        try {
            var url = protocol + "//" + host + "/" + appname + "Disruption/GetDisruptionById?id=" + ID;
            $("#ModalTitle").html("Update Template");
            $("#Modal").modal("show");
            $.ajax({
                type: "GET",
                url: url,
                success: function (data) {
                    var obj = JSON.parse(data);
                    $("#rowid").text(obj.rowid);
                    $("#flight_number").text(obj.flight_number);
                    $("#intimation_refno").text(obj.intimation_refno);
                    $("#origin").text(obj.origin);
                    $("#destination").text(obj.destination);
                    $("#actual_departure").text(obj.actual_departure);
                    $("#actual_arrival").text(obj.actual_arrival);
                    $("#revised_departure").text(obj.revised_departure);
                    $("#revised_arrival").text(obj.revised_arrival);
                    $("#disruption_type").text(obj.disruption_type);
                    $("#sms").text(obj.sms);
                    $("#email").text(obj.email);
                    $("#out_calling").text(obj.out_calling);
                    $("#remarks").text(obj.remarks);
                    $("#domestic_template").text(obj.domestic_template);
                    $("#international_template").text(obj.international_template);

                    $('#SMSContentModal').modal();
                }
            })

        } catch (errorMessage) {
            toastr.error(errorMessage)
        }
    }

</script>