@model IEnumerable<Alliance_Air_Desk.Models.Model.DisruptionModel>
@using GridMvc.Html
@{
    ViewBag.Title = "Index";
    WebGrid webGrid = new WebGrid(source: Model, canSort: false, canPage: false);
}

<h4>Disruption Management - @Model.Count() Records found</h4>

<a href="@Url.Action("Management", "Disruption")" class="btn btn-success">
    Create New
    <span class="glyphicon glyphicon-plus-sign" aria-hidden="true"></span>
</a>
<a id="btnGet" @Html.ActionLink("Export to Excel", "Export_Disruption_Management", "Disruption", new { @class = "btn pull-right btn-success" })</a>


<script>
    $('#btnGet').click(function () {
        $("#loading").fadeOut(5000);
    });
</script>

@*<a href="#" data-toggle="popover" title="Popover Header" data-placement="bottom" data-content="Filter Option available on all column"><span class="glyphicon glyphicon-info-sign"></span></a>*@
<hr />


@if (Model != null)
{
    <div class="table-responsive">
        <div style="width:100%;" class="table table-striped table-bordered table-sm">
            @Html.Grid(Model).Columns(columns =>
       {
           columns.Add().Encoded(false).Sanitized(false).SetWidth(30)
           .RenderValueAs(c => Html.ActionLink("Edit", "Management", new { id = c.guid }, new { @class = "btn btn-primary" })).Filterable(false);


           columns.Add(e => e.sno).Titled("SNo").Filterable(true);
           columns.Add(e => e.flight_number).Titled("Flight #").Filterable(true);
           columns.Add(e => e.origin).Titled("Origin").Filterable(true);
           columns.Add(e => e.destination).Titled("Destination").Filterable(true);
           columns.Add(e => e.actual_departure).Titled("Actual Departure").Filterable(true);
           columns.Add(e => e.actual_arrival).Titled("Actual Arrival").Filterable(true);
           columns.Add(e => e.revised_departure).Titled("Revised Departure").Filterable(true);
           columns.Add(e => e.revised_arrival).Titled("Revised Arrival").Filterable(true);
           columns.Add(e => e.disruption_type).Titled("Type").Filterable(true);
           columns.Add(e => e.status).Titled("Status").Filterable(true);
           columns.Add(e => e.QC_status).Titled("QC_Status").Filterable(true);
           columns.Add(e => e.QC_Doneby).Titled("QC Done by").Filterable(true);

           //columns.Add(e => e.sms).Titled("SMS").Filterable(true);
           //columns.Add(e => e.email).Titled("Email).").Filterable(true);
           //columns.Add(e => e.out_calling).Titled("Out Calling").Filterable(true);
           //columns.Add(e => e.remarks).Titled("Remarks").Filterable(true);
           //columns.Add(e => e.createdBy).Titled("Created By").Filterable(true);
           //columns.Add(e => e.createdTime).Titled("Created Time").Filterable(true);
           //columns.Add(e => e.modifiedBy).Titled("Modified By").Filterable(true);
           //columns.Add(e => e.modifiedTime).Titled("Modified Time").Filterable(true);

           //columns.Add().Titled("Status").Sanitized(false).Encoded(false).
           //RenderValueAs(data => "<button type='submit' class='btn btn-primary' value=''>Download</button>");


       }).WithPaging(10).Sortable(true).EmptyText("No Record Found")
        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <div style="width:100%;" class="table table-striped table-bordered table-sm">
            <p>No Record Found</p>
        </div>
    </div>
}


<link href="@Url.Content("~/Content/Gridmvc.css")" rel="stylesheet" />
<script src="@Url.Content("~/Scripts/jquery-3.4.1.min.js")"></script>
<script src="@Url.Content("~/Scripts/gridmvc.min.js")"></script>