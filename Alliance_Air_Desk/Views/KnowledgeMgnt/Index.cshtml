@model Alliance_Air_Desk.Models.Model.KnowledgeMgntModel

@{
    ViewBag.Title = "Knowledge Mgnt";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*<h2>Index</h2>*@

@using (Html.BeginForm("Index", "KnowledgeMgnt", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmDesk" }))

{
    @Html.AntiForgeryToken()


    <div class="row">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="panel">
            <div class="panel-heading custom-header-panel">
                <h3 class="panel-title roboto">Knowledge Management File Upload (pdf format only) </h3>
            </div>
            <div class="panel-body">
                @*@if (@Session["Privilege"] != null)
                    {
                        if (Convert.ToInt32(@Session["Privilege"]) <= 4)
                        {*@
                <div class="row">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="form-group">
                        @Html.LabelFor(model => model.FileImg, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-3">
                            <input type='file' name='file' />
                            @Html.ValidationMessageFor(model => model.FileImg, "", new { @class = "text-danger" })
                           
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-offset-2">
                            <input type="submit" value="Create" class="btn btn-success" />
                        </div>
                    </div>


                    @*}
                        }*@

                    <div class="col-md-2">
                        @Html.ActionLink("View Document", "Document", "KnowledgeMgnt")
                    </div>


                </div>
                @*<hr>
                    <div class="container">
                        <div>@Html.Raw(ViewBag.WordHtml)</div>
                    </div>*@
            </div>
        </div>
    </div>
}

@*<div>
        @Html.ActionLink("Back to List", "Index")
    </div>*@

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}



<script>

                    $(document).ready(function () {
                        toastr.options = {
                            "closeButton": true,
                            "debug": false,
                            "positionClass": "toast-top-right",
                            "onclick": null,
                            "showDuration": "1000",
                            "hideDuration": "1000",
                            "timeOut": "5000",
                            "extendedTimeOut": "1000",
                            "showEasing": "swing",
                            "hideEasing": "linear",
                            "showMethod": "fadeIn",
                            "hideMethod": "fadeOut",
                            "newestOnTop": true,
                            "progressBar": true,
                            "preventDuplicates": false
                        };

                        if ('@TempData["Message"]' != null && '@TempData["Message"]' != "") {
                            toastr.success('@TempData["Message"]')
                        }

                        if ('@TempData["ErrorMessage"]' != null && '@TempData["ErrorMessage"]' != "") {
                            toastr.error('@TempData["ErrorMessage"]')
                        }

                        if ('@TempData["Info"]' != null && '@TempData["Info"]' != "") {
                            toastr.info('@TempData["Info"]')
                        }

                        if ('@TempData["Warning"]' != null && '@TempData["Warning"]' != "") {
                            toastr.warning('@TempData["Warning"]')
                        }
                    });


</script>

