@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<script>

    $(document).ready(function () {
    toastr.options = {
        "closeButton": true,
        "debug": false,
        "positionClass": "toast-top-right",
        "onclick": null,
        "showDuration": "1000",
        "hideDuration": "1000",
        "timeOut": "5000",
        "extendedTimeOut": "1000",
        "showEasing": "swing",
        "hideEasing": "linear",
        "showMethod": "fadeIn",
        "hideMethod": "fadeOut",
        "newestOnTop": true,
        "progressBar": true,
        "preventDuplicates": false
    };


    $('#PdfArea').hide('fade');
});


    $(document).ready(function () {
        $('#DivCloseBtn').click(function () {
            $('#PdfArea').hide('fade');
            $('#BtnArea').show('fade');
        });
    });

function togglePDFViewer(event, viewerId,names) {
  // prevent default link behavior
  event.preventDefault();
  // get all PDF viewers and links
  var pdfViewers = document.querySelectorAll("[id^='pdfViewer']");
  var links = document.getElementsByTagName("a");
  // hide all PDF viewers and remove "active" class from all links
  for (var i = 0; i < pdfViewers.length; i++) {
    pdfViewers[i].style.display = "none";
  }
  for (var i = 0; i < links.length; i++) {
    links[i].classList.remove("active");
  }
  // show selected PDF viewer and add "active" class to selected link
  var selectedViewer = document.getElementById(viewerId);
  selectedViewer.style.display = "block";
  event.currentTarget.classList.add("active");
  toastr.success(names + ' !')
  
  $('#PdfTitle').text(names);
  $('#PdfArea').show('fade');
  $('#BtnArea').hide('fade');
}
</script>