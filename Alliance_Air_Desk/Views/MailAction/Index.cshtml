@model Alliance_Air_Desk.Models.Model.MailActionModel

@{
   ViewBag.Title = "Mail Action";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
}




@using (Html.BeginForm()) 
{
    @Html.AntiForgeryToken()
    <div class="row">
      
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="panel">
            <div class="panel-heading custom-header-panel">
                <h3 class="panel-title roboto">Mail Action</h3>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-5">
                        <div class="input-group">
                            <div class="input-group-btn bs-dropdown-to-select-group">
                                <button type="button" class="btn btn-primary dropdown-toggle as-is bs-dropdown-to-select" data-toggle="dropdown" tabindex="-1">
                                    <span data-bind="bs-drp-sel-label">Email</span>
                                    <input type="hidden" name="hdSearchCriteria" id="hdSearchCriteria" data-bind="bs-drp-sel-value" value="Email">
                                    <span class="caret"></span>
                                </button>
                                <ul class="dropdown-menu" role="menu" style="max-height 300px;">
                                    <li data-value="Email"><a href="#">Email </a></li>
                                    <li data-value="ReferenceNo"><a href="#">Reference ID </a></li>
                                    <li data-value="PNR"><a href="#">PNR </a></li>
                                </ul>
                            </div>
                            <input type="text" id="searchInput" name="searchInput" value="@ViewBag.searchValue" class="form-control" aria-label="..." required>
                            <span class="input-group-btn">
                                <button class="btn btn-pri" type="button" id="search">Search</button>
                            </span>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-3 col-md-3" id="DivSearch">
                        <div class="form-group">
                            <input type="button" class="btn btn-primary" id="CntrlCallhistory" name="CntrlCallhistory" value="Show/Hide History">
                        </div>
                    </div>

                    <div class="col-md-4 pull-right" id="DivFilter">
                        <input type="text" id="myInput" onkeyup="myFunction()" class="form-control" placeholder="Search Call History with all fields">
                        <script>
                            $(document).ready(function () {
                                $("#myInput").on("keyup", function () {
                                    var value = $(this).val().toLowerCase();
                                    $("#myTable .even").filter(function () {
                                        $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                                    });
                                });
                            });
                        </script>
                    </div>
                </div>
                <br />
                <div id="DivCallHistory" style="width:100%;" class="table table-responsive table-bordered table-sm">
                    <table class="table table-responsive" style="width:100%;" id="myTable">
                        <thead style="background:#3568ab;color:white">
                            <tr>
                                <th>View</th>
                                <th>SNo</th>
                                <th>Date</th>
                                <th>Ref.ID</th>
                                <th>PNR</th>
                                <th>QRC</th>
                                <th>Maintype</th>
                                <th>Subtype</th>
                                <th>Resolution</th>
                                @*<th>Resolution 2</th>*@
                            </tr>
                        </thead>
                        <tbody id="SetData">
                            <tr id="LoadingStatus" style="color:red"></tr>
                        </tbody>
                    </table>
                </div>

                        <div class="row">
                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.fromEmail, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.fromEmail, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.fromEmail, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.date_of_mail, htmlAttributes: new { @class = "control-label" })
                                    <input type="datetime-local" asp-for="date_of_mail" class="form-control" id="date_of_mail" name="date_of_mail" value="@ViewBag.date_of_mail" required />
                                    @Html.ValidationMessageFor(model => model.date_of_mail, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xs-12 col-sm-4 col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.phoneNo, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.phoneNo, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.phoneNo, "", new { @class = "text-danger" })
                                </div>
                            </div>


                            <div class="col-xs-12 col-sm-4 col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.referenceId, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.referenceId, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                    @Html.ValidationMessageFor(model => model.referenceId, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-xs-12 col-sm-4 col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.pnr, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.pnr, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.pnr, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.mailSubject, htmlAttributes: new { @class = "control-label" })
                            @Html.EditorFor(model => model.mailSubject, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.mailSubject, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.mailContent, htmlAttributes: new { @class = "control-label" })
                            @Html.EditorFor(model => model.mailContent, new { htmlAttributes = new { @class = "form-control", style = "height:300px" } })
                            @Html.ValidationMessageFor(model => model.mailContent, "", new { @class = "text-danger" })
                        </div>

                        <div class="row DivElement">
                            <div class="col-xs-12 col-sm-4 col-md-2">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.QRC, htmlAttributes: new { @class = "control-label" })
                                    @Html.DropDownListFor(m => m.QRC, Model.QRC_List, "Please select", new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.QRC, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-4 col-md-2">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.type_of_mail, htmlAttributes: new { @class = "control-label" })
                                    @Html.DropDownListFor(m => m.type_of_mail, Model.type_of_mail_List, "Please select", new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.type_of_mail, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-4 col-md-2">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.subType, htmlAttributes: new { @class = "control-label" })
                                    @Html.DropDownListFor(m => m.subType, Model.subType_List, "Please select", new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.subType, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-4 col-md-3">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.resolution, htmlAttributes: new { @class = "control-label" })
                                    @Html.DropDownListFor(m => m.resolution, Model.resolution_List, "Please select", new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.resolution, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-4 col-md-3">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.resolution2, htmlAttributes: new { @class = "control-label" })
                                    @Html.DropDownListFor(m => m.resolution2, Model.resolution2_List, "Please select", new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.resolution2, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.content_template, htmlAttributes: new { @class = "control-label" })
                            @Html.EditorFor(model => model.content_template, new { htmlAttributes = new { @class = "form-control", style = "height:300px" } })
                            @Html.ValidationMessageFor(model => model.content_template, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.remarks, htmlAttributes: new { @class = "control-label" })
                            @Html.EditorFor(model => model.remarks,  new { htmlAttributes = new { @class = "form-control"  } })
                            @Html.ValidationMessageFor(model => model.remarks, "", new { @class = "text-danger" })
                        </div>

                            @if (Model != null)
                            {
                                @Html.HiddenFor(model => model.guid, new { value = Model.guid })
                                @Html.HiddenFor(model => model.rowid, new { value = Model.rowid })
                            }

                        <div class="form-group">
                            <input type="button" class="btn btn-primary" id="btnsaveContinue" name="btnsaveContinue" value="Save">

                            <input type="button" class="btn btn-default" id="btnclear" name="btnclear" value="Clear">
                        </div>
                    </div>
            </div>
</div>



