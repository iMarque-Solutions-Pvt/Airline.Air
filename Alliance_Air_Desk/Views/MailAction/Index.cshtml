    $(document).ready(function () {
        $("#search").click(function () {
            $("#SetData").empty();
            var searchtype = $("#hdSearchCriteria").val();
            var input = $("#searchInput").val();
            if (input.length == 0) {
                $("#searchInput").focus();
                toastr.error('Please Supply valid Input')
                $(".loadingDiv-parent").fadeOut("slow");
                $('#DivSearch').hide();
                $('#DivCallHistory').hide();
                $('#DivFilter').hide();
                return;
            }
            $(".loadingDiv-parent").fadeIn(50);
            var Email = $('#Email').val();
            $("#LoadingStatus").html("Loading....");
            $.get(protocol + "//" + host + "/" + appname + "MailAction/Get_Mail_History?searchno=" + input + "&searchtype=" + searchtype, null, DataBind);
            
            function DataBind(data) {

                if (data.length > 0) {

                    $('#DivSearch').show();
                    $('#DivCallHistory').show();
                    $('#DivFilter').show();

                    var SetData = $("#SetData");
                    for (var i = 0; i < data.length; i++) {
                        var Data = "<tr class='even row_" + data[i].sno + "'>" +
                            "<td>" + "<a href='#' data-toggle='tooltip' title='Click to View Full Details' class='btn-sm btn-warning' onclick='getMailInfo(" + data[i].id + ")'><span class='glyphicon glyphicon-eye-open' ></span></a>" + "</td>" +
                            "<td>" + data[i].sno + "</td>" +
                            "<td>" + data[i].date + "</td>" +
                            "<td>" + data[i].referenceId + "</td>" +
                            "<td>" + data[i].pnr + "</td>" +
                            "<td>" + data[i].Qrc + "</td>" +
                            "<td>" + data[i].maintype + "</td>" +
                            "<td>" + data[i].subtype + "</td>" +
                            "<td>" + data[i].resolution + "</td>" +
                            /*"<td>" + data[i].resolution2 + "</td>" +*/
                            "</tr>";
                        SetData.append(Data);
                        $("#LoadingStatus").html(" ");
                    }
                }
                else {
                    $('#DivSearch').hide();
                    $('#DivCallHistory').hide();
                    $('#DivFilter').hide();
                }
            }

            $(".loadingDiv-parent").fadeOut("slow");
            if (searchtype == "Email") {
                $("#pnr").val('');
                $("#referenceId").val('');
                $("#fromEmail").val(input);
            }
            else if (searchtype == "ReferenceNo") {
                $("#fromEmail").val('');
                $("#pnr").val('');
                $("#referenceId").val(input);

            }
            else if (searchtype == "PNR") {
                $("#fromEmail").val('');
                $("#referenceId").val('');
                $("#pnr").val(input);
            }
        })
    })

