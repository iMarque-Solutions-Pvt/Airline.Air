<div>
    @*@Html.ActionLink("Back to List", "Details")*@
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<script>
   

    
    $(document).ready(function () {
        $("section:contains('xxx')").each(function () {
            $(this).html(
              $(this).html().replace(/xxx/g, "<span class='match-o'>xxx</span>")
            );
        });
    });



    var protocol = $(location).attr('protocol');
    var host = $(location).attr('host');
    var hostname = $(location).attr('hostname');
    var pathName = $(location).attr('pathname').split('/')[1] + "/";
    var appname;
    if (hostname == 'localhost') {
        appname = "";
    }
    else {
        appname = pathName;
    }


    $(document).ready(function () {
        toastr.options = {
            "closeButton": true,
            "debug": false,
            "positionClass": "toast-top-right",
            "onclick": null,
            "showDuration": "1000",
            "hideDuration": "1000",
            "timeOut": "5000",
            "extendedTimeOut": "1000",
            "showEasing": "swing",
            "hideEasing": "linear",
            "showMethod": "fadeIn",
            "hideMethod": "fadeOut",
            "newestOnTop": true,
            "progressBar": true,
            "preventDuplicates": false
        };

        if ('@ViewData["Message"]' != null && '@ViewData["Message"]' != "") {
            toastr.success('@ViewData["Message"]')
        }

        if ('@ViewData["ErrorMessage"]' != null && '@ViewData["ErrorMessage"]' != "") {
            toastr.error('@ViewData["ErrorMessage"]')
        }

        if ('@ViewData["Info"]' != null && '@ViewData["Info"]' != "") {
            toastr.info('@ViewData["Info"]')
        }

        if ('@ViewData["Warning"]' != null && '@ViewData["Warning"]' != "") {
            toastr.warning('@ViewData["Warning"]')
        }
    });


    $(document).ready(function () {
        $(function () {
           
            $('#DivCallHistory').hide();
            $('#DivFilter').hide();
            $('#DivSearch').hide();
        });
    });

    $(document).ready(function () {
        $(function () {
            $("#btnclear").click(function () {
                $(".loadingDiv-parent").fadeIn(50);
                var url = '@Url.Content("~/")' + 'MailAction/Index';
                $(location).attr('href', url);
                $(".loadingDiv-parent").fadeOut("slow");
            });
        });
    });

    function getMailInfo(ID) {
        try {
            var url = protocol + "//" + host + "/" + appname + "MailAction/GetPreviousMailInfoById?id=" + ID;
            $("#ModalTitle").html("Previous Mail Information");
            $.ajax({
                type: "GET",
                url: url,
                success: function (data) {
                    var obj = JSON.parse(data);
                    $("#lbl_EmailID").text(obj.fromEmail);
                    $("#lbl_EmailDate").text(obj.date_of_mail);
                    $("#lbl_phoneNo").text(obj.phoneNo);
                    $("#lbl_referenceId").text(obj.referenceId);
                    $("#lbl_pnr").text(obj.pnr);
                    $("#lbl_mailSubject").text(obj.mailSubject);
                    $("#lbl_mailContent").text(obj.mailContent);
                    $("#lbl_Qrc").text(obj.QRC);
                    $("#lbl_mailType").text(obj.type_of_mail);
                    $("#lbl_subType").text(obj.subType);
                    $("#lbl_resolution").text(obj.resolution);
                    $("#lbl_resolution2").text(obj.resolution2);
                    $("#lbl_content_template").text(obj.content_template);
                    $("#lbl_remarks").text(obj.remarks);
                    $("#lbl_loggedBy").text(obj.loggedBy);
                    $("#lbl_loggedTime").text(obj.loggedTime);

                    $('#MailDetailsModal').modal();
                }
            })

        } catch (errorMessage) {
            toastr.error(errorMessage)
        }
    }
   

    $(document).ready(function () {
        $(function () {
            $("#btnsaveContinue").click(function () {
                $(".loadingDiv-parent").fadeIn(50);
                var MailActionModel = new Object();
                MailActionModel.rowid = $('#rowid').val();
                MailActionModel.guid = $('#guid').val();
                MailActionModel.fromEmail = $('#fromEmail').val();
                MailActionModel.date_of_mail = $('#date_of_mail').val();
                MailActionModel.pnr = $('#pnr').val();
                MailActionModel.phoneNo = $('#phoneNo').val();
                MailActionModel.referenceId = $('#referenceId').val();
                MailActionModel.mailSubject = $('#mailSubject').val();
                MailActionModel.mailContent = $('#mailContent').val();
                MailActionModel.QRC = $('#QRC').val();
                MailActionModel.type_of_mail= $('#type_of_mail').val();
                MailActionModel.subType = $('#subType').val();
                MailActionModel.resolution = $('#resolution').val();
                MailActionModel.resolution2 = $('#resolution2').val();
                MailActionModel.content_template = $('#content_template').val();
                MailActionModel.remarks = $('#remarks').val();
 
                

                if (MailActionModel.fromEmail == null || MailActionModel.fromEmail == '' || MailActionModel.fromEmail.length == 0) {
                    $("#fromEmail").focus();
                    toastr.error('Please Enter Email')
                    $(".loadingDiv-parent").fadeOut("slow");
                    return;
                }
                if (MailActionModel.date_of_mail == null || MailActionModel.date_of_mail == '') {
                    $("#date_of_mail").focus();
                    toastr.error('Please Enter Mail Date')
                    $(".loadingDiv-parent").fadeOut("slow");
                    return;
                }
                if (MailActionModel.mailSubject == null || MailActionModel.mailSubject == '' || MailActionModel.mailSubject.length == 0) {
                    $("#mailSubject").focus();
                    toastr.error('Please Enter Mail Subject')
                    $(".loadingDiv-parent").fadeOut("slow");
                    return;
                }
                if (MailActionModel.mailContent == null || MailActionModel.mailContent == '' || MailActionModel.mailContent.length == 0) {
                    $("#mailSubject").focus();
                    toastr.error('Please Enter Mail Content')
                    $(".loadingDiv-parent").fadeOut("slow");
                    return;
                }


                if (MailActionModel.QRC == null || MailActionModel.QRC == '') {
                    $("#QRC").focus();
                    toastr.error('Please Select QRC Type')
                    $(".loadingDiv-parent").fadeOut("slow");
                    return;
                }

               
                if (MailActionModel.type_of_mail == null || MailActionModel.type_of_mail == '') {
                    $("#type_of_mail").focus();
                    toastr.error('Please Select Mail Type')
                    $(".loadingDiv-parent").fadeOut("slow");
                    return;
                }

                if (MailActionModel.subType == null || MailActionModel.subType == '') {
                    $("#subType").focus();
                    toastr.error('Please Select SubType')
                    $(".loadingDiv-parent").fadeOut("slow");
                    return;
                }

                if (MailActionModel.resolution == null || MailActionModel.resolution == '') {
                    $("#resolution").focus();
                    toastr.error('Please Select Resolution')
                    $(".loadingDiv-parent").fadeOut("slow");
                    return;
                }


               if (MailActionModel.fromEmail.length > 0) {
                    $.ajax({
                        type: "POST",
                        url: '@Url.Content("~/")' + "MailAction/PostData",
                        data: JSON.stringify(MailActionModel),
                        contentType: "application/json;",
                        dataType: "json",
                        success: function (data) {

                            if (data != null) {
                                if (data != undefined) {
                                    if (data.status == "success") {
                                        toastr.success(data.msg)
                                        $(".loadingDiv-parent").fadeOut("slow");
                                        $("#referenceId").val(data.resultCode)
                                        $("#fromEmail").val('');
                                        $("#date_of_mail").val('');
                                        $("#phoneNo").val('');
                                        $("#pnr").val('');
                                        $("#mailContent").val('');
                                        $("#mailSubject").val('');
                                        $("#type_of_mail").val('');
                                        $("#subType").val('');
                                        $("#resolution").val('');
                                        $("#content_template").val('')
                                        $("#remarks").val('');
                                        $("#type_of_mail").prop("disabled", true);
                                        $("#subType").prop("disabled", true);
                                        $("#resolution").prop("disabled", true);
                                        $("#type_of_mail").focus();
                                        $("#resolution2").val('');
                                        $("#resolution2").prop("disabled", true);
                                    }
                                    if (data.status == "error") {
                                        toastr.error(data.msg)
                                        $(".loadingDiv-parent").fadeOut("slow");
                                    }
                                } else {
                                    toastr.error('undefined')
                                    $(".loadingDiv-parent").fadeOut("slow");
                                }
                            } else {
                                $(".loadingDiv-parent").fadeOut("slow");
                                toastr.error('Something went wrong')
                                return;
                            }

                        },
                        failure: function (response) {
                            toastr.error(data.responseText)
                            $(".loadingDiv-parent").fadeOut("slow");

                        },
                        error: function (response) {
