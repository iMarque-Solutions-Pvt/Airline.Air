       <style>
        .button-container {
            position: absolute;
            top: 50%;
            right: 0;
            transform: translateY(-50%);
        }

        .custom-btn {
            background-color: #3459e6;
            color: #fff;
            border: none;
            padding: 12px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
            transition: padding 0.10s ease-in-out;
            border-radius: 5px 0px 0px 5px;
        }

            .custom-btn:hover {
                padding-right: 40px; /* Increase padding on hover */
            }

            .custom-btn::after {
                content: ""; /* Clear the default content */
                display: inline-block;
                margin-left: 5px;
                width: 38px; /* Adjust the width and height as needed */
                height: 34px;
                background-image: url('../Input/new-email.png'); /* Specify the image path */
                background-size: cover; /* Adjust the background size as needed */
                background-repeat: no-repeat; /* Prevent image repetition */
            }

            /*.custom-btn::after {
                content: "?";
                display: inline-block;
                margin-left: 5px;
                font-weight: bold;
            }*/

            .custom-btn:hover::after {
                content: "Briefing";
                font-weight: bold;
                display: flex; /* Use flexbox */
                justify-content: center; /* Center align content */
                align-items: center; /* Align items vertically center */
                width: 50px;
                border-radius: 5px 0px 0px 5px;
                background-image: url(''); /* Show text on hover */
            }
    </style>

    <script>
        $(window).on('load', function () {
            $(".loadingDiv-parent").fadeOut("slow");
        });
        $(window).on('beforeunload', function () {
            $(".loadingDiv-parent").fadeIn(50);
        });
    </script>
    <script>
        // Wait for the DOM to finish loading before accessing elements
        document.addEventListener("DOMContentLoaded", function () {
            // Get the button
            var mybutton = document.getElementById("myBtn");

            // Check if the button exists before proceeding
            if (mybutton) {
                // When the user scrolls down 20px from the top of the document, show the button
                window.onscroll = function () { scrollFunction() };

                function scrollFunction() {
                    if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
                        mybutton.style.display = "block";
                    } else {
                        mybutton.style.display = "none";
                    }
                }

                // When the user clicks on the button, scroll to the top of the document
                function topFunction() {
                    document.body.scrollTop = 0;
                    document.documentElement.scrollTop = 0;
                }
            }
        });
    </script>


