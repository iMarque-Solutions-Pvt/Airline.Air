@model IEnumerable<Alliance_Air_Desk.Models.Model.AccountModel>
@using GridMvc.Html
@{
    ViewBag.Title = "User List";
    WebGrid webGrid = new WebGrid(source: Model, canSort: false, canPage: false);
}


<h4>User Master - @Model.Count() Records found</h4>

<a href="@Url.Action("UserMaster", "Account")" class="btn btn-success">
    Create New
    <span class="glyphicon glyphicon-plus-sign" aria-hidden="true"></span>
</a>
<a id="btnGet" @Html.ActionLink("Export to Excel", "Export_User_List", "Account", new { @class = "btn pull-right btn-success" })</a>


<script>
    $('#btnGet').click(function () {
        $("#loading").fadeOut(5000);
    });
</script>

@*<a href="#" data-toggle="popover" title="Popover Header" data-placement="bottom" data-content="Filter Option available on all column"><span class="glyphicon glyphicon-info-sign"></span></a>*@
<hr />


@if (@ViewBag.Message != null)
{
    <div class="col-md-12">
        <div class="alert alert-success-alt alert-dismissable">
            <span class="glyphicon glyphicon-certificate"></span>
            <button type="button" class="close" data-dismiss="alert" aria-hidden="true">
                ×
            </button><strong>Success!</strong> @ViewBag.Message
        </div>
    </div>
}

@if (@ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger-alt alert-dismissable">
        <span class="glyphicon glyphicon-certificate"></span>
        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">
            ×
        </button><strong>Error!</strong> @ViewBag.ErrorMessage
    </div>
}



@if (TempData["Message"] != null)
{
    <div class="alert alert-success-alt alert-dismissable" style="margin-top:20px">
        <span class="glyphicon glyphicon-certificate"></span>
        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">
            ×
        </button><strong>Success!</strong> @TempData["Message"]
    </div>

}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger-alt alert-dismissable" style="margin-top:20px">
        <span class="glyphicon glyphicon-certificate"></span>
        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">
            ×
        </button><strong>Error!</strong> @TempData["ErrorMessage"]
    </div>
}

@if (Model != null)
{
    <div class="table-responsive">
        <div style="width:100%;" class="table table-striped table-bordered table-sm">
            @Html.Grid(Model).Columns(columns =>
       {
           columns.Add().Encoded(false).Sanitized(false).SetWidth(30)
           .RenderValueAs(c => Html.ActionLink("Edit", "UserMaster", new { id = c.guid }, new { @class = "btn btn-primary" })).Filterable(false);
           columns.Add(e => e.sno).Titled("SNo").Filterable(true);
           columns.Add(e => e.userId).Titled("User ID").Filterable(true);
           columns.Add(e => e.empCode).Titled("Emp Code").Filterable(true);
           columns.Add(e => e.empName).Titled("Emp Name").Filterable(true);
           columns.Add(e => e.privilege).Titled("Privilege").Filterable(true);
           columns.Add(e => e.region).Titled("Region").Filterable(true);
           columns.Add(e => e.status).Titled("Status").Filterable(true);


           //columns.Add().Titled("Status").Sanitized(false).Encoded(false).
           //RenderValueAs(data => "<button type='submit' class='btn btn-primary' value=''>Download</button>");


       }).WithPaging(10).Sortable(true).EmptyText("No Record Found")
        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <div style="width:100%;" class="table table-striped table-bordered table-sm">
            <p>No Record Found</p>
        </div>
    </div>
}


<link href="@Url.Content("~/Content/Gridmvc.css")" rel="stylesheet" />
<script src="@Url.Content("~/Scripts/jquery-3.4.1.min.js")"></script>
<script src="@Url.Content("~/Scripts/gridmvc.min.js")"></script>