@model IEnumerable<Alliance_Air_Desk.Models.Model.InboundModel>

@{
    ViewBag.Title = "Supervisor Screen";
}

<style>
    .sortable-header {
        cursor: pointer;
        user-select: none;
    }

        .sortable-header:hover {
            background: #28558f !important;
        }

    .sort-icon {
        margin-left: 5px;
        font-size: 11px;
        color: #fff;
    }

    .filter-section {
        background-color: #f8f9fa;
        border: 1px solid #ddd;
        border-radius: 6px;
        padding: 15px 20px;
        margin-bottom: 20px;
        margin-top: 10px;
    }


    .table-section {
        border: 1px solid #ddd;
        border-radius: 6px;
        padding: 15px;
        background-color: #fff;
        margin-top: 50px;
    }

        .table-section table {
            margin-bottom: 0;
        }

    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        background: #f5f5f5;
    }

    .container,
    .container-fluid,
    .body-content {
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 !important;
        padding: 10px !important;
    }

    .supervisor-panel {
        width: 100%;
        margin: 0;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 5px;
        box-sizing: border-box;
        margin-top: 50px;
    }

    .supervisor-title {
        background: #3568ab;
        color: #fff;
        padding: 12px 15px;
        font-size: 20px;
        font-weight: bold;
    }

    .table-area {
        width: 100%;
        overflow-x: auto;
        overflow-y: auto;
        padding: 10px;
        max-height: 600px;
        margin-top: 10px;
    }

    .supervisor-table {
        width: 100%;
        min-width: 1700px;
        border-collapse: collapse;
        background: #fff;
        font-size: 13px;
    }

        .supervisor-table th {
            background: #3568ab;
            color: white;
            text-align: center;
            padding: 10px;
            border: 1px solid #ccc;
            position: sticky;
            top: 0;
            z-index: 10;
            white-space: nowrap;
        }

    .filter-buttons {
        display: flex;
        align-items: flex-end;
        gap: 8px;
        padding-top: 25px;
    }

        .filter-buttons .btn {
            height: 38px;
            min-width: 60px;
        }

    .supervisor-table td {
        padding: 8px;
        text-align: center;
        border: 1px solid #ddd;
        white-space: nowrap;
    }

    .supervisor-table tbody tr:hover {
        background: #f2f7ff;
    }

    .supervisor-table input,
    .supervisor-table select {
        width: 100%;
        min-width: 130px;
        height: 34px;
        font-size: 12px;
    }

    .saveBtn {
        min-width: 80px;
    }

    .no-data-message {
        margin: 20px;
        padding: 15px;
        text-align: center;
        font-weight: 600;
        font-size: 15px;
    }

    .column-filter-icon {
        display: inline-block;
        margin-left: 5px;
        color: #111;
        font-size: 10px;
        cursor: pointer;
    }

        .column-filter-icon:hover {
            color: #ffd700;
        }

    .column-filter-popup {
        position: absolute;
        background: white;
        border: 1px solid #ccc;
        border-radius: 4px;
        padding: 8px;
        width: 190px;
        box-shadow: 0 3px 10px rgba(0,0,0,0.25);
        z-index: 99999;
    }

        .column-filter-popup input {
            width: 100%;
            height: 30px;
            padding: 5px 8px;
            border: 1px solid #aaa;
            border-radius: 3px;
            font-size: 12px;
            margin-bottom: 6px;
        }

        .column-filter-popup .filter-btn,
        .column-filter-popup .cancel-btn {
            font-size: 11px;
            padding: 4px 10px;
            border: none;
            border-radius: 3px;
            cursor: pointer;
        }

    .filter-btn {
        background: #3568ab;
        color: white;
    }

    .cancel-btn {
        background: #6c757d;
        color: white;
        margin-left: 5px;
    }

    .filter-btn:hover {
        background: #28558f;
    }

    .cancel-btn:hover {
        background: #545b62;
    }

    /* =========================================
       SUPERVISOR DASHBOARD
       ========================================= */

    .case-dashboard {
        position: relative;
        display: flex;
        gap: 18px;
        width: 100%;
        padding: 22px 18px;
        box-sizing: border-box;
        background: linear-gradient( 135deg, rgba(53, 104, 171, 0.04), rgba(255, 255, 255, 0.98), rgba(53, 104, 171, 0.06) );
        border-left: 4px solid #3568ab;
        border-bottom: 1px solid #d7e4f2;
        overflow: hidden;
    }


        /* =========================================
       BACKGROUND DECORATIVE LINES
       ========================================= */

        .case-dashboard::before,
        .case-dashboard::after {
            content: "";
            position: absolute;
            width: 180%;
            height: 180%;
            top: -40%;
            left: -40%;
            pointer-events: none;
            background: linear-gradient( 145deg, transparent 48%, rgba(53, 104, 171, 0.10) 49%, transparent 50% ), linear-gradient( 35deg, transparent 48%, rgba(53, 104, 171, 0.07) 49%, transparent 50% ), linear-gradient( 90deg, transparent 49%, rgba(53, 104, 171, 0.05) 50%, transparent 51% );
            background-size: 180px 150px, 220px 180px, 140px 140px;
            transform: rotate(3deg);
        }

        .case-dashboard::after {
            opacity: 0.45;
            transform: rotate(-5deg);
        }


    /* =========================================
       DASHBOARD CARD
       ========================================= */

    .dashboard-card {
        position: relative;
        z-index: 2;
        flex: 1;
        min-height: 105px;
        background: rgba(255, 255, 255, 0.96);
        border: 1px solid #d8e3ef;
        border-left: 4px solid #3568ab;
        border-radius: 5px;
        display: flex;
        align-items: center;
        padding: 18px 22px;
        gap: 18px;
        box-shadow: 0 3px 8px rgba(53, 104, 171, 0.10);
        transition: all 0.25s ease;
    }


        /* Hover */

        .dashboard-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(53, 104, 171, 0.16);
            border-color: #b9cde2;
        }


    /* =========================================
       ICON
       ========================================= */

    .dashboard-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #e9f3fc;
        color: #3568ab;
        font-size: 24px;
        border: 1px solid #c9def2;
        box-shadow: 0 2px 5px rgba(53, 104, 171, 0.12);
    }


    /* =========================================
       CONTENT
       ========================================= */

    .dashboard-content {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }


    .dashboard-label {
        font-size: 14px;
        color: #777;
        font-weight: 500;
        margin-bottom: 5px;
    }


    .dashboard-count {
        font-size: 30px;
        line-height: 32px;
        font-weight: 700;
        color: #3568ab;
    }


    /* =========================================
       TOTAL
       ========================================= */

    .total-card {
        border-left-color: #3568ab;
    }


    /* =========================================
       PENDING
       ========================================= */

    .pending-card {
        border-left-color: #4d82c4;
    }


    /* =========================================
       CLOSED
       ========================================= */

    .closed-card {
        border-left-color: #5aa9d6;
    }


    /* =========================================
       MONTH DISPLAY
       ========================================= */

    #dashboardMonth {
        display: inline-block;
        padding: 5px 14px;
        background: #eef5fc;
        border: 1px solid #c9def2;
        border-radius: 15px;
        color: #3568ab;
        font-size: 12px;
        font-weight: 600;
    }


    /* =========================================
       MOBILE
       ========================================= */

    @@media (max-width: 768px) {

        .case-dashboard {
            flex-direction: column;
            gap: 12px;
        }

        .dashboard-card {
            width: 100%;
        }
    }

    .sort-popup {
        position: absolute;
        background: #fff;
        border: 1px solid #ccc;
        border-radius: 4px;
        box-shadow: 0 3px 10px rgba(0,0,0,0.2);
        padding: 5px;
        z-index: 99999;
        min-width: 100px;
    }

        .sort-popup button {
            display: block;
            width: 100%;
            border: none;
            background: white;
            padding: 7px 10px;
            text-align: left;
            font-size: 12px;
            cursor: pointer;
        }

            .sort-popup button:hover {
                background: #f2f7ff;
            }

    .sortable-header {
        cursor: pointer;
        user-select: none;
    }

        .sortable-header:hover {
            background: #28558f !important;
        }

    .sort-icon {
        margin-left: 5px;
        font-size: 11px;
        color: #fff;
    }
</style>

<div class="supervisor-panel">

    <div class="supervisor-title">
        Supervisor Cases
    </div>

    <!-- Dashboard -->
    <div class="case-dashboard">

        <!-- Total Requests -->
        <div class="dashboard-card total-card">

            <div class="dashboard-icon">
                📋
            </div>

            <div class="dashboard-content">

                <div class="dashboard-label">
                    Total Requests
                </div>

                <div class="dashboard-count" id="totalRequests">
                    0
                </div>

            </div>

        </div>


        <!-- Pending Cases -->
        <div class="dashboard-card pending-card">

            <div class="dashboard-icon">
                ⏳
            </div>

            <div class="dashboard-content">

                <div class="dashboard-label">
                    Pending Cases
                </div>

                <div class="dashboard-count" id="openCases">
                    0
                </div>

            </div>

        </div>


        <!-- Closed Cases -->
        <div class="dashboard-card closed-card">

            <div class="dashboard-icon">
                ✓
            </div>

            <div class="dashboard-content">

                <div class="dashboard-label">
                    Closed Cases
                </div>

                <div class="dashboard-count" id="closedCases">
                    0
                </div>

            </div>

        </div>

    </div>


    <div class="filter-section">
        <div class="row">

            <div class="col-md-2">
                <label>From Date</label>
                <input type="date"
                       id="fromDate"
                       class="form-control"
                       value="@Request["fromDate"]" />
            </div>

            <div class="col-md-2">
                <label>To Date</label>
                <input type="date"
                       id="toDate"
                       class="form-control"
                       value="@Request["toDate"]" />
            </div>


            <div class="col-md-3 filter-buttons">
                <button type="button"
                        id="btnFilter"
                        class="btn btn-primary">
                    Search
                </button>

                <button type="button"
                        id="btnClear"
                        class="btn btn-secondary">
                    Clear
                </button>
            </div>

        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning no-data-message">
            No data found.
        </div>
    }
    else
    {
        <div class="table-area">
            <table class="table supervisor-table">


                <thead>
                    <tr>
                        <th class="sortable-header" data-column="0">
                            SL No
                            <span class="column-filter-icon" data-column="0">▼</span>
                        </th>

                        <th class="sortable-header" data-column="1">
                            Name
                            <span class="column-filter-icon" data-column="1">▼</span>
                        </th>

                        <th class="sortable-header" data-column="2">
                            PNR
                            <span class="column-filter-icon" data-column="2">▼</span>
                        </th>

                        <th class="sortable-header" data-column="3">
                            Phone No
                            <span class="column-filter-icon" data-column="3">▼</span>
                        </th>

                        <th class="sortable-header" data-column="4">
                            QRC
                            <span class="column-filter-icon" data-column="4">▼</span>
                        </th>

                        <th class="sortable-header" data-column="5">
                            Main Type
                            <span class="column-filter-icon" data-column="5">▼</span>
                        </th>

                        <th class="sortable-header" data-column="6">
                            Sub Type
                            <span class="column-filter-icon" data-column="6">▼</span>
                        </th>

                        <th class="sortable-header" data-column="7">
                            Resolution
                            <span class="column-filter-icon" data-column="7">▼</span>
                        </th>

                        <th class="sortable-header" data-column="8">
                            Request Raised By
                            <span class="column-filter-icon" data-column="8">▼</span>
                        </th>

                        <th class="sortable-header" data-column="9">
                            Request Date Time
                            <span class="column-filter-icon" data-column="9">▼</span>
                        </th>

                        <th class="sortable-header" data-column="10">
                            Validated
                            <span class="column-filter-icon" data-column="10">▼</span>
                        </th>

                        <th class="sortable-header" data-column="11">
                            Actioned By
                            <span class="column-filter-icon" data-column="11">▼</span>
                        </th>

                        <th class="sortable-header" data-column="12">
                            Supervisor Remarks
                            <span class="column-filter-icon" data-column="12">▼</span>
                        </th>

                        <th class="sortable-header" data-column="13">
                            Status
                            <span class="column-filter-icon" data-column="13">▼</span>
                        </th>

                        <th>Action</th>

                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <input type="hidden"
                               id="RequestDate_@item.id"
                               value="@Convert.ToDateTime(item.RequestDateandtime).ToString("yyyy-MM-ddTHH:mm")" />

                        <tr>
                            <td>@item.sno</td>
                            <td>@item.name</td>
                            <td>@item.pnr</td>
                            <td>
                                <span class="masked-phone"
                                      data-phone="@item.phoneNo">
                                    @item.phoneNo
                                </span>
                            </td>
                            <td>@item.qrc</td>
                            <td>@item.mainType</td>
                            <td>@item.subType</td>
                            <td>@item.resolution1</td>
                            <td>@item.Requestraisedby</td>
                            <td>@item.RequestDateandtime</td>

                            <td>
                                @Html.DropDownList(
                                    "Validated_" + item.id,
                                    new List<SelectListItem>
                                    {
                                        new SelectListItem
                                        {
                                            Text = "Yes",
                                            Value = "1"
                                        },
                                        new SelectListItem
                                        {
                                            Text = "No",
                                            Value = "2"
                                        }
                                    },
                                    "--Select--",
                                    new
                                    {
                                        @class = "form-control",
                                        id = "Validated_" + item.id
                                    }
                                )
                            </td>

                            <td>

                                <input type="text"
                                       class="form-control"
                                       id="ActionedBy_@item.id"
                                       value="@Session["UserId"] / @Session["userName"]"
                                       readonly />

                            </td>

                            <td>
                                <input type="text"
                                       class="form-control"
                                       id="ActionBySupervisor_@item.id"
                                       value="@item.ActionBySupervisor"
                                       placeholder="Enter action" />
                            </td>

                            <td>
                                <select class="form-control supervisor-status"
                                        id="SupervisorStatus_@item.id">

                                    <option value="1"
                                            @(item.SupervisorStatus == "Open" ? "selected" : "")>
                                        Open
                                    </option>

                                    <option value="2"
                                            @(item.SupervisorStatus == "Closed" ? "selected" : "")>
                                        Closed
                                    </option>
                                </select>
                            </td>

                            <td>
                                <button type="button"
                                        class="btn btn-success saveBtn"
                                        data-id="@item.id">
                                    Save
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<script>
    $(document).on("change", ".closureDateTime", function () {

        var id = $(this).attr("id").split("_")[1];

        var requestDate = new Date($("#RequestDate_" + id).val());
        var closureDate = new Date($(this).val());

        if (isNaN(requestDate.getTime()) || isNaN(closureDate.getTime())) {
            $("#ETA_" + id).val("");
            return;
        }

        var diff = closureDate - requestDate;

        if (diff < 0) {
            $("#ETA_" + id).val("Invalid");
            return;
        }

        var totalMinutes = Math.floor(diff / (1000 * 60));

        var days = Math.floor(totalMinutes / (24 * 60));
        totalMinutes %= (24 * 60);

        var hours = Math.floor(totalMinutes / 60);
        var minutes = totalMinutes % 60;

        $("#ETA_" + id).val(
            days + " Days " +
            hours + " Hrs " +
            minutes + " Min"
        );
    });

    $(document).on("click", ".saveBtn", function () {

        var id = $(this).data("id");
        var validated = $("#Validated_" + id).val();

        if (validated == "" || validated == null) {
            alert("Please select Validated.");
            $("#Validated_" + id).focus();
            return;
        }

        var model = {
            id: id,
            ValidatedStatus: validated,
            ActionedBy: $("#ActionedBy_" + id).val() || null,
            ActionBySupervisor: $("#ActionBySupervisor_" + id).val() || null,
            SupervisorStatus: $("#SupervisorStatus_" + id).val() || null,
            ClosureDateandTime: $("#ClosureDateTime_" + id).val() || null,
            ETAForClosure: $("#ETA_" + id).val() || null
        };

        $.ajax({
            url: '@Url.Action("SaveSupervisorDetails", "Inbound")',
            type: 'POST',
            data: model,

            success: function (result) {

                if (result.success) {
                    alert("Saved successfully.");
                    location.reload();
                }
                else {
                    alert(result.message);
                }
            },

            error: function () {
                alert("Error while saving.");
            }
        });
    });

    $("#btnFilter").click(function () {

        var fromDate = $("#fromDate").val();
        var toDate = $("#toDate").val();

        if (fromDate != "" && toDate != "") {

            if (fromDate > toDate) {
                alert("From Date cannot be greater than To Date.");
                return;
            }
        }

        var url = '@Url.Action("SupervisorScreen", "Inbound")';

        if (fromDate != "" || toDate != "") {
            url += '?fromDate=' + encodeURIComponent(fromDate)
                + '&toDate=' + encodeURIComponent(toDate);
        }

        window.location.href = url;
    });

    $("#btnClear").click(function () {
        window.location.href = '@Url.Action("SupervisorScreen", "Inbound")';
    });

    $(document).ready(function () {
        loadSupervisorDashboard();
        $(".masked-phone").each(function () {
            var phone = $(this).data("phone");
            $(this).text(maskPhoneNumber(phone));
        });
    });

function loadSupervisorDashboard() {

    $.ajax({
        url: '@Url.Action("GetSupervisorDashboard", "Inbound")',
        type: 'GET',
        cache: false,

        success: function (response) {

            if (response.success) {

                $('#totalRequests').text(response.totalRequests);

                $('#openCases').text(response.openCases);

                $('#closedCases').text(response.closedCases);

                $('#dashboardMonth').text(response.monthName);
            }
        },

        error: function () {

            $('#totalRequests').text('0');
            $('#openCases').text('0');
            $('#closedCases').text('0');

        }
    });

}
</script>
<script>
    var columnFilters = {};

    $(document).on("click", ".column-filter-icon", function (e) {

        // VERY IMPORTANT:
        // Prevent click from reaching the <th>
        e.stopPropagation();

        // Close existing filter popup
        $(".column-filter-popup").remove();

        var icon = $(this);
        var columnIndex = parseInt(icon.data("column"));

        // Existing filter value
        var existingValue = columnFilters[columnIndex] || "";

        var popup = $(
            '<div class="column-filter-popup">' +
            '<input type="text" class="filter-input" placeholder="Search..." />' +
            '<div>' +
            '<button type="button" class="filter-btn">Filter</button>' +
            '<button type="button" class="cancel-btn">Cancel</button>' +
            '</div>' +
            '</div>'
        );

        $("body").append(popup);

        popup.find(".filter-input").val(existingValue);

        var offset = icon.offset();

        popup.css({
            top: offset.top + icon.outerHeight() + 5,
            left: offset.left - 60
        });

        popup.data("column", columnIndex);

        popup.find(".filter-input").focus();
    });

    $(document).on("click", ".filter-btn", function () {

        var popup = $(this).closest(".column-filter-popup");

        var columnIndex = popup.data("column");

        var filterValue = popup
            .find(".filter-input")
            .val()
            .toLowerCase()
            .trim();

        if (filterValue === "") {

            delete columnFilters[columnIndex];

        } else {

            columnFilters[columnIndex] = filterValue;
        }

        applyColumnFilters();

        popup.remove();
    });

    $(document).on("click", ".cancel-btn", function () {

        var popup = $(this).closest(".column-filter-popup");

        var columnIndex = popup.data("column");

        delete columnFilters[columnIndex];

        applyColumnFilters();

        popup.remove();
    });

    function applyColumnFilters() {

        $(".supervisor-table tbody tr").each(function () {

            var row = $(this);
            var showRow = true;

            $.each(columnFilters, function (columnIndex, filterValue) {

                if (!filterValue) {
                    return;
                }

                var cell = row.find("td").eq(columnIndex);

                var cellValue = "";

                // Dropdown columns
                if (cell.find("select").length > 0) {

                    cellValue = cell
                        .find("select option:selected")
                        .text()
                        .toLowerCase()
                        .trim();

                } else {

                    cellValue = cell
                        .text()
                        .toLowerCase()
                        .trim();
                }

                if (cellValue.indexOf(filterValue) === -1) {

                    showRow = false;
                    return false;
                }
            });

            if (showRow) {
                row.show();
            } else {
                row.hide();
            }
        });
    }

    $(document).on("click", ".sortable-header", function (e) {

        // If filter icon was clicked,
        // DO NOT SORT
        if ($(e.target).hasClass("column-filter-icon")) {
            return;
        }

        var table = $(".supervisor-table");
        var tbody = table.find("tbody");

        var columnIndex = parseInt($(this).data("column"));

        // Current direction
        var currentDirection =
            $(this).data("direction") || "desc";

        // Toggle
        var newDirection =
            currentDirection === "asc"
                ? "desc"
                : "asc";

        $(".sortable-header").each(function () {

            $(this).data("direction", null);

            $(this)
                .find(".sort-icon")
                .text("↕");
        });

        $(this).data("direction", newDirection);

        $(this)
            .find(".sort-icon")
            .text(
                newDirection === "asc"
                    ? "▲"
                    : "▼"
            );


        var rows = tbody.find("tr").get();

        rows.sort(function (a, b) {

            var A = $(a)
                .children("td")
                .eq(columnIndex)
                .text()
                .trim();

            var B = $(b)
                .children("td")
                .eq(columnIndex)
                .text()
                .trim();

            if (columnIndex === 9) {

                var dateA = parseDateTime(A);
                var dateB = parseDateTime(B);

                return newDirection === "asc"
                    ? dateA - dateB
                    : dateB - dateA;
            }

            var numA = parseFloat(
                A.replace(/,/g, "")
            );

            var numB = parseFloat(
                B.replace(/,/g, "")
            );

            if (!isNaN(numA) && !isNaN(numB)) {

                return newDirection === "asc"
                    ? numA - numB
                    : numB - numA;
            }

            return newDirection === "asc"
                ? A.localeCompare(B)
                : B.localeCompare(A);
        });

        $.each(rows, function (index, row) {

            tbody.append(row);

        });

        applyColumnFilters();

    });

    function parseDateTime(value) {

        if (!value) {
            return 0;
        }

        var parts = value.split(" ");

        if (parts.length >= 2) {

            var dateParts = parts[0].split("/");
            var timeParts = parts[1].split(":");

            if (dateParts.length === 3) {

                return new Date(
                    parseInt(dateParts[2]),
                    parseInt(dateParts[1]) - 1,
                    parseInt(dateParts[0]),
                    parseInt(timeParts[0] || 0),
                    parseInt(timeParts[1] || 0)
                ).getTime();
            }
        }

        return Date.parse(value) || 0;
    }

    function maskPhoneNumber(phone) {

        if (!phone) {
            return "";
        }
        phone = phone.toString().trim();
        var cleanPhone = phone.replace(/\D/g, "");
        if (cleanPhone.length <= 4) {
            return phone;
        }
        var maskedPart = "*".repeat(cleanPhone.length - 4);
        var lastFour = cleanPhone.slice(-4);
        return maskedPart + lastFour;
    }

</script>
