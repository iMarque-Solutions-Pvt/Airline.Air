    function mainType() {

        var url = '@Url.Content("~/")' + "Inbound/getMaintype";
        var ddlsource = "#qrc";
        var ddltarget = "#mainType";
        if ($(ddlsource).val() == "") {
            toastr.error('Please Give valid Input!')
            return false;
        }
        $.getJSON(url, { id: $(ddlsource).val() }, function (data) {
            $(ddltarget).empty();
            $(ddltarget).prop("disabled", false);
            $(ddltarget).append("<option value=''>" + 'Please Select' + "</option>")
            $.each(data, function (index, optionData) {
                $(ddltarget).append("<option value='" + optionData.Value + "'>" + optionData.Text + "</option>");
            });
        });

}



