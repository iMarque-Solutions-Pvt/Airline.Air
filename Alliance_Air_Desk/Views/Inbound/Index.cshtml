    $(document).ready(function () {

        $("#search").click(function () {

            $("#SetData").empty();

            var searchtype = $("#hdSearchCriteria").val();
            var input = $("#searchInput").val();

            // If textbox is already masked, use actual value
            if (searchtype === "PhoneNo") {
                var actualValue = $("#actualSearchInput").val();

                if (actualValue && actualValue.length > 0) {
                    input = actualValue;
                }
            }

            input = input ? input.trim() : "";

            if (input.length === 0) {

                $("#searchInput").focus();

                toastr.error("Please Supply valid Input");

                $("#DivSearch").hide();
                $("#DivCallHistory").hide();
                $("#DivFilter").hide();

                return;
            }

            console.log("Search Type:", searchtype);
            console.log("Actual Search Input:", input);

            // Store ORIGINAL number
            $("#actualSearchInput").val(input);

            $(".loadingDiv-parent").fadeIn(50);
            $("#LoadingStatus").html("Loading....");

            $.get(
                protocol + "//" + host + "/" + appname +
                "Inbound/Get_Call_History?searchno=" +
                encodeURIComponent(input) +
                "&searchtype=" +
                encodeURIComponent(searchtype),

                function (data) {

                    console.log("History Data:", data);

                    if (data && data.length > 0) {

                        $("#DivSearch").show();
                        $("#DivCallHistory").show();
                        $("#DivFilter").show();

                        var SetData = $("#SetData");

                        for (var i = 0; i < data.length; i++) {

                            var Data =
                                "<tr class='even row_" + data[i].sno + "'>" +

                                "<td>" +
                                "<a href='#' data-toggle='tooltip' " +
                                "title='Click to View Full Details' " +
                                "class='btn-sm btn-warning' " +
                                "onclick='getCallInfo(" + data[i].id + ")'>" +
                                "<span class='glyphicon glyphicon-eye-open'></span>" +
                                "</a>" +
                                "</td>" +

                                "<td>" + data[i].sno + "</td>" +
                                "<td>" + data[i].date + "</td>" +
                                "<td>" + data[i].referenceId + "</td>" +
                                "<td>" + data[i].pnr + "</td>" +
                                "<td>" + data[i].maintype + "</td>" +
                                "<td>" + data[i].subtype + "</td>" +
                                "<td>" + data[i].resolution + "</td>" +
                                "<td>" + data[i].HighlighttoSupervisor + "</td>" +

                                "</tr>";

                            SetData.append(Data);
                        }

                        $("#LoadingStatus").html("");

                    }
                    else {

                        $("#DivSearch").hide();
                        $("#DivCallHistory").hide();
                        $("#DivFilter").hide();

                        toastr.info("No call history found");
                    }

                    // IMPORTANT:
                    // Search complete aana apram textbox mask
                    if (searchtype === "PhoneNo") {
                        $("#searchInput").val(maskPhoneNumber(input));
                    }

                    $(".loadingDiv-parent").fadeOut("slow");
                }
            );

            // Other fields
            if (searchtype === "PhoneNo") {

                $("#pnr").val('');
                $("#referenceId").val('');

                // Actual number
                $("#actualPhoneNo").val(input);

                // Masked number
                $("#phoneNo").val(maskPhoneNumber(input));

            }
            else if (searchtype === "ReferenceNo") {

                $("#phoneNo").val("");
                $("#actualPhoneNo").val("");
                $("#pnr").val("");
                $("#referenceId").val(input);

            }
            else if (searchtype === "PNR") {

                $("#phoneNo").val("");
                $("#actualPhoneNo").val("");
                $("#referenceId").val("");
                $("#pnr").val(input);
            }

        });

    });
    function maskPhoneNumber(phone) {
        phone = String(phone || "").trim();
        if (phone.length <= 4) {
            return phone;
        }
        return "*".repeat(phone.length - 4) + phone.slice(-4);
    }

    $('#CntrlCallhistory').click(function () {
        $('#DivCallHistory').toggle('slow');
    });


    $(document).ready(function () {
        var actualPhone = $("#actualPhoneNo").val();
        if (actualPhone && actualPhone.length > 0) {
            $("#phoneNo").val(maskPhoneNumber(actualPhone));
        }
    });

