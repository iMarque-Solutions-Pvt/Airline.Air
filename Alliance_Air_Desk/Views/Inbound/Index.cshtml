    $(document).ready(function () {
        $(function () {
            $("#mainType").change(function () {
                $.clearfields();
                $(".DivPayment").hide();
                var maintypecode = $("#mainType").val();

                if (maintypecode == null || maintypecode == '') {
                    $("#mainType").focus();
                    toastr.error('Please Select Maintype')
                    $(".loadingDiv-parent").fadeOut("slow");
                    return;
                }
                var url = protocol + "//" + host + "/" + appname + "Inbound/Payment_Tab?id=" + maintypecode;
                $.ajax({
