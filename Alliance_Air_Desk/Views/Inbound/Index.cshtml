@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}


<script>

    var protocol = $(location).attr('protocol');
    var host = $(location).attr('host');
    var hostname = $(location).attr('hostname');
    var pathName = $(location).attr('pathname').split('/')[1] + "/";
    var appname;
    if (hostname == 'localhost') {
        appname = "";
    }
    else {
        appname = pathName;
    }


    $(document).ready(function () {
        toastr.options = {
            "closeButton": true,
            "debug": false,
            "positionClass": "toast-top-right",
            "onclick": null,
            "showDuration": "1000",
            "hideDuration": "1000",
            "timeOut": "5000",
            "extendedTimeOut": "1000",
            "showEasing": "swing",
            "hideEasing": "linear",
            "showMethod": "fadeIn",
            "hideMethod": "fadeOut",
            "newestOnTop": true,
            "progressBar": true,
            "preventDuplicates": false
        };

        if ('@ViewData["Message"]' != null && '@ViewData["Message"]' != "") {
            toastr.success('@ViewData["Message"]')
        }

        if ('@ViewData["ErrorMessage"]' != null && '@ViewData["ErrorMessage"]' != "") {
            toastr.error('@ViewData["ErrorMessage"]')
        }

        if ('@ViewData["Info"]' != null && '@ViewData["Info"]' != "") {
            toastr.info('@ViewData["Info"]')
        }

        if ('@ViewData["Warning"]' != null && '@ViewData["Warning"]' != "") {
            toastr.warning('@ViewData["Warning"]')
        }
    });


    $(document).ready(function () {
        $(function () {

            $(".DivPayment").hide();
            $('#DivCallHistory').hide();
            $('#DivFilter').hide();
            $('#DivSearch').hide();
            $('#If_yes').attr('readonly', 'true');
        });
    });

    $(document).ready(function () {
        $(function () {
            $("#btnclear").click(function () {
                $(".loadingDiv-parent").fadeIn(50);
                var url = '@Url.Content("~/")' + 'Inbound/Index';
                $(location).attr('href', url);
                $(".loadingDiv-parent").fadeOut("slow");
            });
        });
    });


    function getCallInfo(ID) {
        try {
            var url = protocol + "//" + host + "/" + appname + "Inbound/GetPreviousCallInfoById?id=" + ID;
            $("#ModalTitle").html("Previous Call Information");
            $.ajax({
                type: "GET",
                url: url,
                success: function (data) {
                    var obj = JSON.parse(data);
                    var phone = String(obj.phoneNo || "").trim();
                    if (phone.length > 4) {
                        phone = "*".repeat(phone.length - 4) + phone.slice(-4);
                    }
                    $("#lbl_phoneNo").text(phone);
                    $("#lbl_referenceId").text(obj.referenceId);
                    $("#lbl_pnr").text(obj.pnr);
                    $("#lbl_name").text(obj.name);
                    $("#lbl_callerCategory").text(obj.callerCategory);
                    $("#lbl_callingState").text(obj.callingState);
                    $("#lbl_language").text(obj.language);
                    $("#lbl_qrc").text(obj.qrc);
                    $("#lbl_mainType").text(obj.mainType);
                    $("#lbl_subType").text(obj.subType);
                    $("#lbl_resolution").text(obj.resolution1);
                    $("#lblHighlighttoSupervisor").text(obj.CaseEscalated);
                    $("#lbl_other_services").text(obj.other_services);
                    $("#lbl_journeyType").text(obj.journeyType);
                    $("#lbl_origin").text(obj.origin);
                    $("#lbl_destination").text(obj.destination);
                    $("#lbl_flightNo").text(obj.flightNo);
                    $("#lbl_paymentType").text(obj.paymentType);
                    $("#lbl_paymentCard").text(obj.paymentCard);
                    $("#lbl_cardType").text(obj.cardType);
                    $("#lbl_payAmount").text(obj.payAmount);
                    $("#lbl_bank").text(obj.bank);
                    $("#lbl_payment_status").text(obj.payment_status);
                    $("#lbl_transactionId").text(obj.transactionId);
                    $("#lbl_remarks").text(obj.remarks);
                    $("#lbl_loggedBy").text(obj.loggedBy);
                    $("#lbl_loggedTime").text(obj.loggedTime);
                    $('#CallDetailsModal').modal();
                }
            })
        } catch (errorMessage) {
            toastr.error(errorMessage)
        }
    }


    $(document).ready(function () {
        $(function () {
            $("#btnsaveContinue").click(function () {
                //alert("hello");
                $(".loadingDiv-parent").fadeIn(50);
                var InboundModel = new Object();
                InboundModel.id = $('#id').val();
                var actualPhone = $('#actualPhoneNo').val();
                var enteredPhone = $('#phoneNo').val();
                if (!actualPhone || actualPhone.trim() === "")
                {
                    actualPhone = enteredPhone;
                }
                InboundModel.phoneNo = actualPhone.trim();
                InboundModel.pnr = $('#pnr').val();
                InboundModel.referenceId = $('#referenceId').val();
                InboundModel.name = $('#name').val();
                InboundModel.callerCategory = $('#callerCategory').val();
                InboundModel.callingState = $('#callingState').val();
                InboundModel.language = $('#language').val();
                InboundModel.qrc = $('#qrc').val();
                InboundModel.mainType = $('#mainType').val();
                InboundModel.subType = $('#subType').val();
                InboundModel.resolution1 = $('#resolution1').val();
                InboundModel.CaseEscalated = $('#CaseEscalated').val();
                InboundModel.journeyType = $('#journeyType').val();
                InboundModel.origin = $('#origin').val();
                InboundModel.destination = $('#destination').val();
                InboundModel.flightNo = $('#flightNo').val();
                InboundModel.penaltyAmt = $('#penaltyAmt').val();
                var other_selected_service = [];
                $("input:checkbox[name='other_service_checked']:checked").each(function () {
                    other_selected_service.push($(this).val());
                });
                InboundModel.other_services = other_selected_service.join(", ");
                InboundModel.paymentType = $('#paymentType').val();
                InboundModel.paymentCard = $('#paymentCard').val();
                InboundModel.cardType = $('#cardType').val();
                InboundModel.payAmount = $('#payAmount').val();
                InboundModel.bank = $('#bank').val();
                InboundModel.payment_status = $('#payment_status').val();
                InboundModel.transactionId = $('#transactionId').val();
                InboundModel.remarks = $('#remarks').val();
                InboundModel.registerId = $('#registerId').val();
                InboundModel.ameyo_userId = $('#ameyo_userId').val();
                InboundModel.campaignId = $('#campaignId').val();
                InboundModel.crtObjectId = $('#crtObjectId').val();
                InboundModel.userCrtObjectId = $('#userCrtObjectId').val();
                InboundModel.customerId = $('#customerId').val();
                InboundModel.dialerSessionId = $('#dialerSessionId').val();
                InboundModel.dispositionName = $('#dispositionName').val();
                InboundModel.Escalation_remarks = $('#Escalation_remarks').val();
                InboundModel.Inb_status = $('#Inb_status').val();
                InboundModel.call_transfer = $('#call_transfer').val();
                InboundModel.If_yes = $('#If_yes').val();
                //alert(InboundModel.id);
                if (InboundModel.phoneNo == null || InboundModel.phoneNo == '' || InboundModel.phoneNo.length == 0) {
                    $("#phoneNo").focus();
                    toastr.error('Please Enter PhoneNo')
                    $(".loadingDiv-parent").fadeOut("slow");
                    return;
                }
                if (InboundModel.name == null || InboundModel.name == '' || InboundModel.name.length == 0) {
                    $("#name").focus();
                    toastr.error('Please Enter Name')
                    $(".loadingDiv-parent").fadeOut("slow");
                    return;
                }
                if (InboundModel.language == null || InboundModel.language == '') {
                    $("#language").focus();
                    toastr.error('Please Select Language')
                    $(".loadingDiv-parent").fadeOut("slow");
                    return;
                }
                if (InboundModel.qrc == null || InboundModel.qrc == '') {
                    $("#qrc").focus();
                    toastr.error('Please Select QRC')
                    $(".loadingDiv-parent").fadeOut("slow");
                    return;
                }
                if (InboundModel.mainType == null || InboundModel.mainType == '') {
                    $("#mainType").focus();
                    toastr.error('Please Select MainType')
                    $(".loadingDiv-parent").fadeOut("slow");
                    return;
                }
                if (InboundModel.subType == null || InboundModel.subType == '') {
                    $("#subType").focus();
                    toastr.error('Please Select SubType')
                    $(".loadingDiv-parent").fadeOut("slow");
                    return;
                }
                if (InboundModel.mainType != '15' && InboundModel.mainType != '16' && InboundModel.mainType != '24' && InboundModel.mainType != '25' && InboundModel.mainType != '36' && InboundModel.mainType != '35')
                {
                   // alert(InboundModel.mainType);
                    if (InboundModel.resolution1 == null || InboundModel.resolution1 == '') {
                        $("#resolution1").focus();
                        toastr.error('Please Select Resolution')
                        $(".loadingDiv-parent").fadeOut("slow");
                        return;
                    }
                }

                if (InboundModel.origin == InboundModel.destination) {
                    $("#destination").focus();
                    toastr.error('Origin and Destination Should not be same.')
                    $(".loadingDiv-parent").fadeOut("slow");
                    return;
                }

                if (InboundModel.CaseEscalated == null || InboundModel.CaseEscalated == '') {
                    $("#CaseEscalated").focus();
                    toastr.error('Please Select Escalate Case')
                    $(".loadingDiv-parent").fadeOut("slow");
                    return;
                }

                if (InboundModel.phoneNo.length > 0) {
                    $.ajax({
                        type: "POST",
                        url: '@Url.Content("~/")' + "Inbound/PostData",
                        data: JSON.stringify(InboundModel),
                        contentType: "application/json;",
                        dataType: "json",
                        success: function (data) {
                            if (data != null) {
                                if (data != undefined) {
                                    if (data.status == "success") {
                                        toastr.success(data.msg)
                                        $(".loadingDiv-parent").fadeOut("slow");
                                        $("#referenceId").val(data.resultCode)
                                        $("#qrc").val('');
                                        //$("#mainType").val('');
                                        //$("#subType").val('');
                                        //$("#resolution1").val('');
                                        //$("#resolution2").val('');
                                        $("#remarks").val('');
                                        $('input[type=checkbox]').prop('checked', false);
                                        $("#mainType").prop("disabled", true);
                                        $("#subType").prop("disabled", true);
                                        $("#resolution1").prop("disabled", true);
                                        $("#resolution2").prop("disabled", true);
                                        $('#penaltyAmt').val('');
                                        $('#penaltyAmt').attr('readonly', 'true');
                                        $("#Escalation_remarks").val('');
                                        $("#qrc").focus();
                                    }
                                    if (data.status == "error") {
                                        toastr.error(data.msg)
                                        $(".loadingDiv-parent").fadeOut("slow");
                                    }
                                } else {
                                    toastr.error('undefined')
                                    $(".loadingDiv-parent").fadeOut("slow");
                                }
                            } else {
                                $(".loadingDiv-parent").fadeOut("slow");
                                toastr.error('Something went wrong')
                                return;
                            }

                        },
                        failure: function (response) {
                            toastr.error(data.responseText)
                            $(".loadingDiv-parent").fadeOut("slow");

                        },
                        error: function (response) {
                            toastr.error(data.responseText)
                            console.log(data.responseText)
                            $(".loadingDiv-parent").fadeOut("slow");
                        }
                    });
                }
                $(".loadingDiv-parent").fadeOut("slow");

            });

        });
    });

    $(document).ready(function () {
        $(function () {
            $("#btndispose").click(function () {
                var ddtext = $("#mainType option:selected").text();
                $("#dispositionName").val(ddtext)

                var InboundModel = new Object();
                InboundModel.phoneNo = $('#phoneNo').val();
