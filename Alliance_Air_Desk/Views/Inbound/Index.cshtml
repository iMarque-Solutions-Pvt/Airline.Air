                                {
                                    <input id="chk@(item.code)" name="other_service_checked" type="checkbox" value="@item.code" checked="@item.isChecked" />
                                    <label class="form-check-label" for="chk@(item.code)">@item.name</label> <br />
                                }
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <a href="#" class="btn btn-primary" data-dismiss="modal" id="r">Save & Close</a>
