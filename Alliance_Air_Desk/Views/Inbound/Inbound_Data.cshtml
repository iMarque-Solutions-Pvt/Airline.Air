@model IEnumerable<Alliance_Air_Desk.Models.Model.InboundModel>

@using GridMvc.Html

@{
    ViewBag.Title = "Inbound Data";
    WebGrid webGrid = new WebGrid(
        source: Model,
        canSort: false,
        canPage: false
    );
}

<h4>Inbound - @Model.Count() Records found</h4>

<a href="@Url.Action("Index", "Inbound")" class="btn btn-success"> Create New <span class="glyphicon glyphicon-plus-sign" aria-hidden="true"></span>
</a>

<a id="btnGet"
   href="@Url.Action("Export_Inbound_Management", "Inbound")"
   class="btn pull-right btn-success">
    Export to Excel
</a>

<script>
    $('#btnGet').click(function () {
        $("#loading").fadeOut(5000);
    });
</script>

<br />
<br />

@if (Model != null)
{
    <div class="table-responsive">
        <div style="width:100%;" class="table table-striped table-bordered table-sm">

            @Html.Grid(Model).Columns(columns =>
            {
                columns.Add()
                    .Encoded(false)
                    .Sanitized(false)
                    .SetWidth(30)
                    .RenderValueAs(c =>
                        Html.ActionLink(
                            "Edit",
                            "Index",
                            new { id = c.id },
                            new { @class = "btn btn-primary" }
                        ))
                    .Filterable(false);

                columns.Add(e => e.sno)
                    .Titled("#")
                    .Filterable(true);

                columns.Add(e => e.loggedBy)
                    .Titled("Created By")
                    .Filterable(true);

                columns.Add(e => e.loggedTime)
                    .Titled("Created Time")
                    .Filterable(true);

                // PHONE NUMBER MASKING
                columns.Add()
                    .Titled("PhoneNo")
                    .Filterable(true)
                    .Encoded(false)
                    .Sanitized(false)
                    .RenderValueAs(c =>
                        string.IsNullOrEmpty(c.phoneNo)
                        ? ""
                        : (c.phoneNo.Length > 4
                            ? c.phoneNo.Substring(0, 2)
                              + "******"
                              + c.phoneNo.Substring(c.phoneNo.Length - 2)
                            : "****")
                    );

                columns.Add(e => e.pnr)
                    .Titled("PNR")
                    .Filterable(true);

                columns.Add(e => e.referenceId)
                    .Titled("ReferenceId")
                    .Filterable(true);

                columns.Add(e => e.mainType)
                    .Titled("MainType")
                    .Filterable(true);

                columns.Add(e => e.subType)
                    .Titled("SubType")
                    .Filterable(true);

                columns.Add(e => e.status)
                    .Titled("Status")
                    .Filterable(true);

                columns.Add(e => e.call_transfer)
                    .Titled("call Transfer")
                    .Filterable(true);

                columns.Add(e => e.If_yes)
                    .Titled("If Yes")
                    .Filterable(true);

            })
            .WithPaging(10)
            .Sortable(true)
            .EmptyText("No Record Found")

        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <div style="width:100%;" class="table table-striped table-bordered table-sm">
            <p>No Record Found</p>
        </div>
    </div>
}

<link href="@Url.Content("~/Content/Gridmvc.css")" rel="stylesheet" />
<script src="@Url.Content("~/Scripts/jquery-3.4.1.min.js")"></script>
<script src="@Url.Content("~/Scripts/gridmvc.min.js")"></script>